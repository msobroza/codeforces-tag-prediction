# The model server's variables beyond CODEFORCES_DEVICE, which the compose profile or the
# Kubernetes overlay sets. Copy this file to deploy/.env.serving (gitignored) and uncomment what
# the deployment needs: a line `KEY=` would set an empty string.
#
# Unquoted KEY=value lines and # comments only, with no `export`: compose reads this file
# (env_file) and strips quotes, while kubectl keeps them and refuses `export`:
#   kubectl create secret generic codeforces-tags-env --from-env-file=deploy/.env.serving
# The SageMaker scripts never read it: a SageMaker model's Environment is not for secrets.

# MLflow's limit on one request, in seconds (60 by default). It can only lower the limit, since
# nginx and SageMaker cut a request at 60 s.
# MLFLOW_SCORING_SERVER_REQUEST_TIMEOUT=30

# API methods only, never baked into an image: OPENAI_API_KEY for the zero-shot methods,
# TYPESAFE_API_KEY for the Jev methods.
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
